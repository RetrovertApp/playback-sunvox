Keep the engine's API out of the host binary's export table.

sunvox_lib.cpp marks every sv_* function with __declspec(dllexport) on
Windows, which is right for the shared library the distribution normally
builds. This plugin links the engine statically, and dllexport in a static
archive is inherited: the linker re-exports all ~100 sv_* symbols from
whatever binary pulls the archive in.

That is a release-gate failure, not a cosmetic one. check_binary requires a
plugin's export table to be exactly rv_playback_plugin, and the Windows job
has no version script to hide the rest -- on Linux the harness passes
--version-script and --exclude-libs,ALL, which is why the same dllexport-free
"extern C" path there has never shown up as a problem.

MAKE_STATIC_LIB already says which kind of build this is, so let it define
SUNVOX_STATIC_LIB -- the name the public header already uses for exactly this
distinction -- and drop the dllexport when it is set. The calling convention
is left alone; only the export attribute goes.

diff --git a/sunvox_lib/main/sunvox_lib.cpp b/sunvox_lib/main/sunvox_lib.cpp
index 1645ad4..18b3658 100644
--- a/sunvox_lib/main/sunvox_lib.cpp
+++ b/sunvox_lib/main/sunvox_lib.cpp
@@ -21,7 +21,11 @@
 //      thread 2: sv_lock_slot(0); sv_remove_module(0,mod2); sv_unlock_slot(0);
 
 #ifdef OS_WIN
-    #define SUNVOX_EXPORT extern "C" __declspec(dllexport) __stdcall
+    #ifdef SUNVOX_STATIC_LIB
+	#define SUNVOX_EXPORT extern "C" __stdcall
+    #else
+	#define SUNVOX_EXPORT extern "C" __declspec(dllexport) __stdcall
+    #endif
 #endif
 #if defined(OS_APPLE) || defined(OS_LINUX) || defined(OS_EMSCRIPTEN)
     #define SUNVOX_EXPORT extern "C"
diff --git a/sunvox_lib/make/Makefile b/sunvox_lib/make/Makefile
index 06862ab..a6520f4 100755
--- a/sunvox_lib/make/Makefile
+++ b/sunvox_lib/make/Makefile
@@ -43,6 +43,12 @@ SUNDOG_DEFINES = \
     -DNOIMAGEFORMATS \
     -DNOMIDI
 
+# A static build gets linked into someone else's binary, so the API must not
+# carry __declspec(dllexport) into that binary's export table.
+ifeq ($(MAKE_STATIC_LIB),true)
+    SUNDOG_DEFINES += -DSUNVOX_STATIC_LIB
+endif
+
 ifneq (,$(findstring linux,$(TARGET_OS)))
 ifeq ($(TARGET_OS),$(filter $(TARGET_OS),linux linux_raspberry_pi))
     LIBS =
